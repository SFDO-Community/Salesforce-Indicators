# This file is used for Git repositories to specify intentionally untracked files that Git should ignore. 
# If you are not using git, you can delete this file. For more information see: https://git-scm.com/docs/gitignore
# For useful gitignore templates see: https://github.com/github/gitignore

# Claude - personal/machine-specific or ephemeral runtime state only.
# .claude/skills/ and .claude/commands/ are shared team tooling and ARE tracked.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# Playwright (REGRESSION-TESTING) - generated screenshots/reports, regenerate by re-running the specs
regression/playwright/output/

# Salesforce cache
.sf/
.sfdx/
.localdevserver/
deploy-options.json

# CCI
.cci
/src.orig
/src
test_results.json
test_results.xml

# Python
*.pyc
__pycache__

# Robot Framework results
robot/Salesforce-Indicators/results/

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Editors
*.sublime-project
*.sublime-workspace
.vscode
.idea
.project
.settings

# VS Code project settings
.vscode/

# Media from the documentation-video pipeline (storage strategy undecided)
recordings/**/*.mp4
recordings/**/shots/
videos/**/renders/
videos/**/.media/
videos/**/.thumbnails/
videos/**/.hyperframes/
videos/**/.waveform-cache/

# Playwright sessions and traces (never commit)
**/storageState*.json
**/.playwright*/
**/trace*.zip
regression/playwright/output/

# TEMPORARY SUPRESSION
artifact-feedback.md
unpackaged/config/pipeline_Lead
tasks/cci_demo.py

.tours/documentation-video-pipeline.tour
recordings/documentation/download-as-json/
videos/download-as-json-walkthrough/

